PORT=3000
# ВКонтакте: сервисный ключ доступа приложения (vk.com/apps?act=manage → приложение → Настройки)
VK_TOKEN=
# Розыгрыши в Instagram скрыты, пока не сделан вход клиентов через Instagram. 1 — показать снова
INSTAGRAM_ENABLED=0
# Instagram Graph API: долгосрочный токен и ID профессионального аккаунта
IG_TOKEN=
IG_USER_ID=

# Адрес сайта (для возврата после оплаты), например https://rozygrysh.ru
PUBLIC_URL=
# E-mail администраторов через запятую — им доступна страница /admin.html
ADMIN_EMAILS=admin@example.ru
# 1 — cookie только по HTTPS (обязательно при работе через HTTPS)
COOKIE_SECURE=0
# 1 — сервер стоит за nginx/Caddy, брать IP клиента из X-Forwarded-For
TRUST_PROXY=0
# production — отключает тестовую оплату
NODE_ENV=

# ЮKassa: личный кабинет → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать чек (54-ФЗ); код НДС: 1 — без НДС, 2 — 0%, 4 — 20% и т.д.
YOOKASSA_RECEIPT=0
YOOKASSA_VAT_CODE=1

# Почта для восстановления пароля (SMTP). Порт 465 — TLS, 587 — STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ЧестныйРозыгрыш <noreply@example.ru>
